{
  "name": "bowr",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "check": "pnpm lint && pnpm typecheck && pnpm test:unit && pnpm worker:test",
    "lint": "eslint . && pnpm lint:functions && pnpm worker:lint",
    "lint:functions": "cd supabase/functions && deno lint && deno fmt --check",
    "typecheck": "pnpm -r --parallel run typecheck && pnpm typecheck:functions",
    "typecheck:functions": "deno check --config supabase/functions/deno.json supabase/functions/api/index.ts supabase/functions/maintenance/index.ts",
    "test:unit": "vitest run --project packages",
    "test:db": "supabase test db",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "build:web": "pnpm --filter @bowr/app export:web && pnpm --filter @bowr/app check:web",
    "worker:test": "cd services/worker && uv run pytest",
    "worker:lint": "cd services/worker && uv run ruff check . && uv run ruff format --check .",
    "ops:bootstrap-owner": "node scripts/ops/bootstrap-owner.mjs",
    "test:integration": "vitest run --project integration"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@supabase/supabase-js": "2.117.1",
    "deno": "2.9.6",
    "eslint": "9.39.1",
    "eslint-config-expo": "57.0.2",
    "postgres": "3.4.7",
    "supabase": "2.118.0",
    "typescript": "~6.0.3",
    "vitest": "5.0.2"
  }
}
