# Variable names used by bowr. Never commit values; see docs/runbooks/environments.md.
#
# Web client (apps/app/.env.local): public values only
#   EXPO_PUBLIC_SUPABASE_URL, EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY, EXPO_PUBLIC_AUTH_GOOGLE_ENABLED
#
# Edge Functions (supabase/functions/.env locally; project secrets in staging/production)
#   APP_ORIGINS                 exact web origins allowed by CORS, comma-separated
#
# Operator shell only (never in the app, Edge or worker runtime)
DATABASE_URL=
