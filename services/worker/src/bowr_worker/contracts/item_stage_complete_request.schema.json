{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "number",
          "const": 1
        },
        "lease_generation": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "outcome": {
          "type": "string",
          "const": "ready"
        },
        "outputs": {
          "type": "object",
          "properties": {
            "cutout": {
              "type": "object",
              "properties": {
                "width": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 1024
                },
                "height": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 1024
                },
                "byte_size": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "width",
                "height",
                "byte_size",
                "sha256"
              ],
              "additionalProperties": false
            },
            "thumbnail": {
              "type": "object",
              "properties": {
                "width": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 256
                },
                "height": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 256
                },
                "byte_size": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "width",
                "height",
                "byte_size",
                "sha256"
              ],
              "additionalProperties": false
            },
            "mask": {
              "type": "object",
              "properties": {
                "width": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 1024
                },
                "height": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 1024
                },
                "byte_size": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "width",
                "height",
                "byte_size",
                "sha256"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "cutout",
            "thumbnail",
            "mask"
          ],
          "additionalProperties": false
        },
        "result": {
          "type": "object",
          "properties": {
            "foreground_ratio": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "foreground_ratio"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "lease_generation",
        "outcome",
        "outputs",
        "result"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "number",
          "const": 1
        },
        "lease_generation": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "outcome": {
          "type": "string",
          "const": "ready"
        },
        "result": {
          "type": "object",
          "properties": {
            "suggested": {
              "type": "object",
              "properties": {
                "colors": {
                  "minItems": 1,
                  "maxItems": 5,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 20
                      },
                      "hex": {
                        "type": "string",
                        "pattern": "^#[0-9A-F]{6}$"
                      },
                      "proportion": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      }
                    },
                    "required": [
                      "name",
                      "hex",
                      "proportion"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "colors"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "suggested"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "lease_generation",
        "outcome",
        "result"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "number",
          "const": 1
        },
        "lease_generation": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "outcome": {
          "type": "string",
          "const": "ready"
        },
        "result": {
          "type": "object",
          "properties": {
            "model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "model_revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "preprocess_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "vector": {
              "minItems": 512,
              "maxItems": 512,
              "type": "array",
              "items": {
                "type": "number"
              }
            }
          },
          "required": [
            "model",
            "model_revision",
            "preprocess_version",
            "vector"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "lease_generation",
        "outcome",
        "result"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "number",
          "const": 1
        },
        "lease_generation": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "outcome": {
          "type": "string",
          "const": "rejected"
        },
        "failure_code": {
          "type": "string",
          "enum": [
            "NO_FOREGROUND",
            "SOURCE_MISSING",
            "CORRUPT_IMAGE",
            "MODEL_UNAVAILABLE"
          ]
        }
      },
      "required": [
        "schema_version",
        "lease_generation",
        "outcome",
        "failure_code"
      ],
      "additionalProperties": false
    }
  ]
}
