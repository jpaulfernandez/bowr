{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "job_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "kind": {
      "type": "string",
      "const": "validate_upload"
    },
    "lease_generation": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "lease_expires_at": {
      "type": "string"
    },
    "capability": {
      "type": "string",
      "minLength": 20,
      "maxLength": 2000
    },
    "input": {
      "type": "object",
      "properties": {
        "declared_content_type": {
          "type": "string",
          "enum": [
            "image/jpeg",
            "image/png",
            "image/webp",
            "image/heic",
            "image/heif"
          ]
        },
        "purpose": {
          "type": "string",
          "enum": [
            "garment",
            "care_label"
          ]
        },
        "rotation": {
          "anyOf": [
            {
              "type": "number",
              "const": 0
            },
            {
              "type": "number",
              "const": 90
            },
            {
              "type": "number",
              "const": 180
            },
            {
              "type": "number",
              "const": 270
            }
          ]
        },
        "max_bytes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "max_pixels": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "max_edge": {
          "anyOf": [
            {
              "type": "number",
              "const": 1024
            },
            {
              "type": "number",
              "const": 2048
            }
          ]
        }
      },
      "required": [
        "declared_content_type",
        "purpose",
        "rotation",
        "max_bytes",
        "max_pixels",
        "max_edge"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "url"
      ],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "content_type": {
          "type": "string",
          "const": "image/webp"
        }
      },
      "required": [
        "url",
        "content_type"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "job_id",
    "kind",
    "lease_generation",
    "lease_expires_at",
    "capability",
    "input",
    "source",
    "output"
  ],
  "additionalProperties": false
}
