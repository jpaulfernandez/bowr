{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "number",
          "const": 1
        },
        "lease_generation": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "outcome": {
          "type": "string",
          "const": "ready"
        },
        "output": {
          "type": "object",
          "properties": {
            "width": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 2048
            },
            "height": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 2048
            },
            "byte_size": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "width",
            "height",
            "byte_size",
            "sha256"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "lease_generation",
        "outcome",
        "output"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "number",
          "const": 1
        },
        "lease_generation": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "outcome": {
          "type": "string",
          "const": "rejected"
        },
        "failure_code": {
          "type": "string",
          "enum": [
            "UNSUPPORTED_MEDIA",
            "MEDIA_TYPE_MISMATCH",
            "FILE_TOO_LARGE",
            "TOO_MANY_PIXELS",
            "CORRUPT_IMAGE",
            "ANIMATED_IMAGE",
            "SOURCE_MISSING"
          ]
        }
      },
      "required": [
        "schema_version",
        "lease_generation",
        "outcome",
        "failure_code"
      ],
      "additionalProperties": false
    }
  ]
}
