# Local Edge Function environment. Copy to supabase/functions/.env (gitignored).
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY come from the runtime.
# The values below are for the local stack only; staging and production use
# independently generated secrets (docs/runbooks/environments.md).

# Exact web origins allowed by CORS, comma-separated.
APP_ORIGINS=http://localhost:8081,http://localhost:4173
# HMAC key for invite code digests and IP hashes (at least 32 bytes).
INVITE_HMAC_SECRET=local-only-invite-hmac-secret-0123456789abcdef
# Must match the Vault secret bowr_maintenance_secret (supabase/seed.sql locally).
MAINTENANCE_SECRET=local-only-maintenance-secret-0123456789abcdef
