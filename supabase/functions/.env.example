# Local Edge Function environment. Copy to supabase/functions/.env (gitignored).
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY come from the runtime.
# The values below are for the local stack only; staging and production use
# independently generated secrets (docs/runbooks/environments.md).

# Exact web origins allowed by CORS, comma-separated.
APP_ORIGINS=http://localhost:8081,http://localhost:4173
# HMAC key for invite code digests and IP hashes (at least 32 bytes).
INVITE_HMAC_SECRET=local-only-invite-hmac-secret-0123456789abcdef
# Must match the Vault secret bowr_maintenance_secret (supabase/seed.sql locally).
MAINTENANCE_SECRET=local-only-maintenance-secret-0123456789abcdef

# Private object storage (R2 in staging/production; infra/local/compose.yaml here).
R2_ACCESS_KEY_ID=local-storage-access-key
R2_SECRET_ACCESS_KEY=local-storage-secret-key-0123456789abcdef
R2_BUCKET=bowr-private
# Address browsers and the worker use (and that signatures are made for).
R2_PUBLIC_ENDPOINT=http://127.0.0.1:9000
# Address the Edge runtime uses for its own HEAD/GET/DELETE calls.
R2_INTERNAL_ENDPOINT=http://bowr_storage:7070
# Advertise HEIC/HEIF only where the deployed worker passed the HEIC fixtures.
UPLOAD_HEIC_ENABLED=true

# Worker dispatch (Modal proxy-auth headers in staging/production).
WORKER_DISPATCH_URL=http://host.docker.internal:8765/wake
WORKER_DISPATCH_KEY=local-worker-key
WORKER_DISPATCH_SECRET=local-only-worker-dispatch-secret-0123456789
# Signs job-scoped worker capabilities (at least 32 bytes).
WORKER_CAPABILITY_SECRET=local-only-worker-capability-secret-0123456789

# AI gateway. AI stays off unless AI_ENABLED=true, which staging/production set
# only after the paid-provider verification gate (P0.05-T5). Locally the gateway
# talks to scripts/dev/fake-gemini.mjs.
AI_ENABLED=true
GEMINI_API_KEY=local-fake-gemini-key
GEMINI_BASE_URL=http://host.docker.internal:8790
AI_CALL_TIMEOUT_MS=4000

# Deletion journal (P0.07): a separate bucket outside the database backup timeline.
DELETION_JOURNAL_BUCKET=bowr-journal
# Read-only token for the external health check (GET /functions/v1/maintenance/health).
HEALTH_CHECK_TOKEN=local-only-health-check-token-0123456789abcdef
# Server-side analytics (PostHog capture API). Unset to disable. Locally the
# integration tests run a capture stand-in on this port.
POSTHOG_HOST=http://host.docker.internal:8792
POSTHOG_API_KEY=phc_local_fake_project_key
