# Public client configuration only. Never put secrets in EXPO_PUBLIC_* values.
# Local values come from `pnpm exec supabase status`.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Origin of private photo storage (R2 endpoint in staging/production), for the CSP.
EXPO_PUBLIC_MEDIA_ORIGIN=http://127.0.0.1:9000
# Set to "true" only where Google OAuth is configured for this environment.
EXPO_PUBLIC_AUTH_GOOGLE_ENABLED=false
# PostHog capture host and public project key. Leave both empty to send no analytics.
# Locally the E2E tests intercept this host; nothing needs to listen on it.
EXPO_PUBLIC_POSTHOG_HOST=http://127.0.0.1:8793
EXPO_PUBLIC_POSTHOG_KEY=phc_local_fake_project_key
